# Deployment settings for `npm run deploy`.
# Copy this file to `.env.local` or export the variables in your shell.

DEPLOY_REMOTE=user@example.com
DEPLOY_REMOTE_DIR=/var/www/your-site
DEPLOY_LOCAL_DIST=dist
CHECK_BASE_URL=https://fxin.cc
CHECK_TIMEOUT_MS=12000

# Optional. Leave empty to disable browser RUM in public builds.
VITE_RUM_ENDPOINT=
